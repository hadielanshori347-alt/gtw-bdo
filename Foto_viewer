// ── Parse foto_url: bisa string URL lama atau JSON baru ──
function _parseFotoUrl(fotoUrl) {
  if (!fotoUrl) return null;
  // Coba parse JSON (format baru)
  try {
    var data = JSON.parse(fotoUrl);
    if (data.thumb) return data;
  } catch(e) {}
  // Format lama: plain URL
  return {
    thumb   : fotoUrl,
    download: fotoUrl.replace('/thumbnail?', '/uc?export=download&').replace('&sz=w1000', '').replace('&sz=w800', ''),
    view    : fotoUrl,
    fileId  : ''
  };
}

// ── Thumbnail di tabel (override fungsi lama) ──
function fotoThumb(fotoUrl) {
  if (!fotoUrl) return '<span style="font-size:11px;color:var(--gray4)">-</span>';
  var foto = _parseFotoUrl(fotoUrl);
  if (!foto) return '<span style="font-size:11px;color:var(--gray4)">-</span>';
  return '<img src="' + foto.thumb + '" ' +
    'onclick="openFotoViewer(\'' + escQ(fotoUrl) + '\')" ' +
    'style="width:42px;height:34px;object-fit:cover;border-radius:4px;border:1px solid var(--gray3);cursor:pointer" ' +
    'onerror="this.style.display=\'none\'">';
}

// ── Buka fullscreen viewer ──
function openFotoViewer(fotoUrlRaw) {
  var foto = _parseFotoUrl(fotoUrlRaw);
  if (!foto) return;

  // Buat overlay kalau belum ada
  var existing = document.getElementById('fotoViewerOverlay');
  if (existing) existing.remove();

  var overlay = document.createElement('div');
  overlay.id = 'fotoViewerOverlay';
  overlay.innerHTML =
    '<div class="fv-backdrop" onclick="closeFotoViewer()"></div>' +
    '<div class="fv-container">' +
      '<div class="fv-header">' +
        '<span class="fv-title"><span class="material-icons-round">photo</span> Foto</span>' +
        '<div class="fv-actions">' +
          // Tombol download — pakai URL download resolusi asli
          '<a class="fv-btn fv-btn-download" href="' + foto.download + '" download ' +
            'onclick="toast(\'Mengunduh foto...\',\'\')">' +
            '<span class="material-icons-round">download</span> Simpan ke HP' +
          '</a>' +
          // Tombol buka di tab baru
          '<a class="fv-btn fv-btn-open" href="' + foto.view + '" target="_blank">' +
            '<span class="material-icons-round">open_in_new</span> Buka GDrive' +
          '</a>' +
          '<button class="fv-btn fv-btn-close" onclick="closeFotoViewer()">' +
            '<span class="material-icons-round">close</span>' +
          '</button>' +
        '</div>' +
      '</div>' +
      '<div class="fv-body">' +
        '<img class="fv-img" src="' + foto.thumb + '" ' +
          'onerror="this.src=\'' + foto.view + '\'">' +
        '<div class="fv-loading" id="fvLoading">' +
          '<div style="width:28px;height:28px;border:3px solid rgba(255,255,255,.3);border-top:3px solid #fff;border-radius:50%;animation:spin .65s linear infinite"></div>' +
        '</div>' +
      '</div>' +
      '<div class="fv-footer">' +
        '<span class="material-icons-round" style="font-size:13px;color:rgba(255,255,255,.5)">info</span>' +
        '<span>Tap <strong>Simpan ke HP</strong> untuk download foto ke perangkat</span>' +
      '</div>' +
    '</div>';

  document.body.appendChild(overlay);

  // Sembunyikan loading setelah gambar load
  var img = overlay.querySelector('.fv-img');
  img.onload  = function() {
    var ld = document.getElementById('fvLoading');
    if (ld) ld.style.display = 'none';
  };
  img.onerror = function() {
    var ld = document.getElementById('fvLoading');
    if (ld) ld.innerHTML = '<span style="color:rgba(255,255,255,.6);font-size:12px">Gagal memuat foto</span>';
  };

  // Animasi masuk
  requestAnimationFrame(function() { overlay.classList.add('fv-open'); });

  // Tutup dengan ESC
  overlay._escHandler = function(e) { if (e.key === 'Escape') closeFotoViewer(); };
  document.addEventListener('keydown', overlay._escHandler);
}

function closeFotoViewer() {
  var overlay = document.getElementById('fotoViewerOverlay');
  if (!overlay) return;
  document.removeEventListener('keydown', overlay._escHandler);
  overlay.classList.remove('fv-open');
  setTimeout(function() { if (overlay.parentNode) overlay.parentNode.removeChild(overlay); }, 250);
}

// ── Update photo box di detail modal (override fungsi lama) ──
function renderDetailPhotoBox(fotoUrl, isSelesai) {
  var pb   = document.getElementById('detailPhotoBox');
  var foto = _parseFotoUrl(fotoUrl);

  if (foto) {
    pb.innerHTML =
      '<img src="' + foto.thumb + '" ' +
        'style="width:100%;display:block;cursor:pointer" ' +
        'onclick="openFotoViewer(\'' + escQ(fotoUrl) + '\')" ' +
        'onerror="this.parentElement.innerHTML=\'<span class=no-img><span class=material-icons-round>broken_image</span>Foto gagal dimuat</span>\'">' +
      '<div class="fv-detail-actions">' +
        '<a class="fv-btn fv-btn-download" href="' + foto.download + '" download>' +
          '<span class="material-icons-round">download</span> Simpan ke HP' +
        '</a>' +
        '<a class="fv-btn fv-btn-open" href="' + foto.view + '" target="_blank">' +
          '<span class="material-icons-round">open_in_new</span> GDrive' +
        '</a>' +
      '</div>';
    pb.onclick = null;
    pb.style.cursor = 'default';
  } else {
    pb.innerHTML = '<span class="no-img"><span class="material-icons-round">photo_camera</span>Belum ada foto</span>';
    pb.onclick = null;
    pb.style.cursor = 'default';
  }
}

