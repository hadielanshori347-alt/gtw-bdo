// ────────────────────────────────────────────────────────────
// CLEAR FILTER
// ────────────────────────────────────────────────────────────
function clearObFilter()  { _clearFilter('ob');  }
function clearHvsFilter() { _clearFilter('hvs'); }
function clearIbFilter()  { _clearFilter('ib');  }

function _clearFilter(type) {
  var today    = new Date();
  var todayStr = today.toISOString().substring(0, 10);
  var firstDay = new Date(today.getFullYear(), today.getMonth(), 1).toISOString().substring(0, 10);

  document.getElementById(type + 'FilterFrom').value     = firstDay;
  document.getElementById(type + 'FilterTo').value       = todayStr;
  document.getElementById(type + 'FilterStatus').value   = '';
  document.getElementById(type + 'FilterIncharge').value = '';
  _updateArchiveBadge(type, false);
  _filterState[type] = { from: firstDay, to: todayStr, status: '', incharge: '' };

  // Render ulang dari data lokal
  if (type === 'ob')  renderObTable();
  if (type === 'hvs') renderHvsTable();
  if (type === 'ib')  renderIbTable();
}

// ────────────────────────────────────────────────────────────
// EXPORT CSV HASIL FILTER
// ────────────────────────────────────────────────────────────
function exportObFilteredCSV()  { _exportFiltered('ob');  }
function exportHvsFilteredCSV() { _exportFiltered('hvs'); }
function exportIbFilteredCSV()  { _exportFiltered('ib');  }

function _exportFiltered(type) {
  var f    = _filterState[type];
  var needsArchive = _needsArchive(f.from);

  function doExport(data) {
    var headers = type === 'ib'
      ? ['no_track','incharge','service','from','tujuan','created_date','status','total_awb']
      : ['no_track','incharge','service','tujuan','created_date','status','total_awb'];
    var rows = [headers];
    data.forEach(function(r) {
      rows.push(headers.map(function(h) { return r[h] !== undefined ? r[h] : ''; }));
    });
    var d = new Date();
    var dateStr = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    _downloadCSV(rows, type.toUpperCase() + '_filter_' + dateStr + '.csv');
  }

  if (needsArchive) {
    var action = type === 'ob' ? 'getObListFiltered' : type === 'hvs' ? 'getHvsListFiltered' : 'getIbListFiltered';
    gasGet(action, { dateFrom: f.from, dateTo: f.to, status: f.status, incharge: f.incharge })
      .then(function(res) { doExport(res.list || []); })
      .catch(function(e) { toast('Gagal export: ' + e.message, 'error'); });
  } else {
    var src = type === 'ob' ? obData : type === 'hvs' ? hvsData : ibData;
    var data = src.filter(function(item) {
      var d = (item.created_date || '').substring(0, 10);
      if (f.from     && d < f.from)                return false;
      if (f.to       && d > f.to)                  return false;
      if (f.status   && item.status !== f.status)   return false;
      if (f.incharge && item.incharge !== f.incharge) return false;
      return true;
    });
    doExport(data);
  }
}

